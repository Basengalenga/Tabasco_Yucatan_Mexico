// Dimensional model of the gold layer (economia_digital_dw).
// Render: dot -Tpng -Gdpi=150 docs/warehouse_model.dot -o docs/warehouse_model.png
digraph warehouse_model {
    graph [rankdir=LR, splines=spline, nodesep=0.45, ranksep=1.2, fontname="Helvetica", fontsize=20,
           labelloc=t, label=<<b>economia_digital_dw · gold layer · star schema</b><br/><font point-size="6"> </font><br/><font point-size="12">blue = dimensions · orange = facts · green = analysis results (src/gold_analytics.py)</font>>, pad=0.4];
    node  [shape=plaintext, fontname="Helvetica", fontsize=11];
    edge  [arrowhead=crow, arrowtail=tee, dir=both, color="#555555", penwidth=1.2];

    dim_entidad [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white">
        <tr><td bgcolor="#2E6FAC" colspan="2"><font color="white"><b>dim_entidad</b></font></td></tr>
        <tr><td bgcolor="#DCE8F5" colspan="2"><i>grain: state (32) + national '00'</i></td></tr>
        <tr><td align="left"><b>cve_ent</b></td><td align="left" port="cve_ent">CHAR(2) PK</td></tr><tr><td align="left">nombre</td><td align="left" port="nombre">TEXT</td></tr><tr><td align="left">es_foco</td><td align="left" port="es_foco">BOOLEAN</td></tr>
      </table>>];
    dim_tiempo [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white">
        <tr><td bgcolor="#2E6FAC" colspan="2"><font color="white"><b>dim_tiempo</b></font></td></tr>
        <tr><td bgcolor="#DCE8F5" colspan="2"><i>grain: year (2003-2025)</i></td></tr>
        <tr><td align="left"><b>anio</b></td><td align="left" port="anio">SMALLINT PK</td></tr><tr><td align="left">sexenio</td><td align="left" port="sexenio">TEXT</td></tr>
      </table>>];
    dim_indicador [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white">
        <tr><td bgcolor="#2E6FAC" colspan="2"><font color="white"><b>dim_indicador</b></font></td></tr>
        <tr><td bgcolor="#DCE8F5" colspan="2"><i>grain: indicator (23)</i></td></tr>
        <tr><td align="left"><b>id_indicador</b></td><td align="left" port="id_indicador">TEXT PK</td></tr><tr><td align="left">nombre</td><td align="left" port="nombre">TEXT</td></tr><tr><td align="left">dimension</td><td align="left" port="dimension">acceso/uso/valor/brecha</td></tr><tr><td align="left">unidad</td><td align="left" port="unidad">TEXT</td></tr><tr><td align="left">universo</td><td align="left" port="universo">TEXT</td></tr><tr><td align="left">fuente</td><td align="left" port="fuente">TEXT</td></tr>
      </table>>];
    dim_pais [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white">
        <tr><td bgcolor="#2E6FAC" colspan="2"><font color="white"><b>dim_pais</b></font></td></tr>
        <tr><td bgcolor="#DCE8F5" colspan="2"><i>grain: OECD country / aggregate</i></td></tr>
        <tr><td align="left"><b>cod_pais</b></td><td align="left" port="cod_pais">TEXT PK</td></tr><tr><td align="left">nombre</td><td align="left" port="nombre">TEXT</td></tr>
      </table>>];
    fact_encuesta_tic [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white">
        <tr><td bgcolor="#C0602B" colspan="2"><font color="white"><b>fact_encuesta_tic</b></font></td></tr>
        <tr><td bgcolor="#F8E3D6" colspan="2"><i>grain: year × state × indicator × age group</i></td></tr>
        <tr><td align="left">anio</td><td align="left" port="anio">FK</td></tr><tr><td align="left">cve_ent</td><td align="left" port="cve_ent">FK</td></tr><tr><td align="left">id_indicador</td><td align="left" port="id_indicador">FK</td></tr><tr><td align="left">grupo_edad</td><td align="left" port="grupo_edad">total | 16_74</td></tr><tr><td align="left">estimacion</td><td align="left" port="estimacion">% (0-100)</td></tr><tr><td align="left">error_estandar</td><td align="left" port="error_estandar">Taylor, design-based</td></tr><tr><td align="left">cv · li_90 · ls_90</td><td align="left" port="cv · li_90 · ls_90">DOUBLE</td></tr><tr><td align="left">calidad</td><td align="left" port="calidad">alta/moderada/baja</td></tr><tr><td align="left">n_muestra</td><td align="left" port="n_muestra">INTEGER</td></tr><tr><td align="left">universo_expandido</td><td align="left" port="universo_expandido">BIGINT</td></tr>
      </table>>];
    fact_valor_entidad [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white">
        <tr><td bgcolor="#C0602B" colspan="2"><font color="white"><b>fact_valor_entidad</b></font></td></tr>
        <tr><td bgcolor="#F8E3D6" colspan="2"><i>grain: year × state × concept × prices</i></td></tr>
        <tr><td align="left">anio</td><td align="left" port="anio">FK</td></tr><tr><td align="left">cve_ent</td><td align="left" port="cve_ent">FK</td></tr><tr><td align="left">concepto</td><td align="left" port="concepto">vab_total | vab_51 | vab_21</td></tr><tr><td align="left">precios</td><td align="left" port="precios">corrientes | constantes_2018</td></tr><tr><td align="left">valor_mdp</td><td align="left" port="valor_mdp">DOUBLE</td></tr><tr><td align="left">estatus_cifra</td><td align="left" port="estatus_cifra">TEXT</td></tr>
      </table>>];
    fact_comercio_electronico [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white">
        <tr><td bgcolor="#C0602B" colspan="2"><font color="white"><b>fact_comercio_electronico</b></font></td></tr>
        <tr><td bgcolor="#F8E3D6" colspan="2"><i>grain: year × component × measure (national)</i></td></tr>
        <tr><td align="left">anio</td><td align="left" port="anio">FK</td></tr><tr><td align="left">componente</td><td align="left" port="componente">TEXT</td></tr><tr><td align="left">medida</td><td align="left" port="medida">mdp / pct_pib / pct_vab</td></tr><tr><td align="left">valor</td><td align="left" port="valor">DOUBLE</td></tr>
      </table>>];
    fact_oecd_tic [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white">
        <tr><td bgcolor="#C0602B" colspan="2"><font color="white"><b>fact_oecd_tic</b></font></td></tr>
        <tr><td bgcolor="#F8E3D6" colspan="2"><i>grain: year × country × measure</i></td></tr>
        <tr><td align="left">anio</td><td align="left" port="anio">FK</td></tr><tr><td align="left">cod_pais</td><td align="left" port="cod_pais">FK</td></tr><tr><td align="left">medida</td><td align="left" port="medida">TEXT</td></tr><tr><td align="left">unidad</td><td align="left" port="unidad">TEXT</td></tr><tr><td align="left">valor</td><td align="left" port="valor">DOUBLE</td></tr><tr><td align="left">estatus_obs</td><td align="left" port="estatus_obs">TEXT</td></tr>
      </table>>];
    resultado_brecha [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white">
        <tr><td bgcolor="#3F7F5F" colspan="2"><font color="white"><b>resultado_brecha</b></font></td></tr>
        <tr><td bgcolor="#DDEFE4" colspan="2"><i>year × indicator × pair (z-test)</i></td></tr>
        <tr><td align="left">anio</td><td align="left" port="anio">SMALLINT</td></tr><tr><td align="left">id_indicador</td><td align="left" port="id_indicador">TEXT</td></tr><tr><td align="left">entidad_a · entidad_b</td><td align="left" port="entidad_a · entidad_b">CHAR(2)</td></tr><tr><td align="left">diferencia_pp · p_value</td><td align="left" port="diferencia_pp · p_value">DOUBLE</td></tr>
      </table>>];
    resultado_tendencia [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white">
        <tr><td bgcolor="#3F7F5F" colspan="2"><font color="white"><b>resultado_tendencia</b></font></td></tr>
        <tr><td bgcolor="#DDEFE4" colspan="2"><i>focus state × indicator</i></td></tr>
        <tr><td align="left">cve_ent</td><td align="left" port="cve_ent">CHAR(2)</td></tr><tr><td align="left">id_indicador</td><td align="left" port="id_indicador">TEXT</td></tr><tr><td align="left">cambio_pp · p_value</td><td align="left" port="cambio_pp · p_value">DOUBLE</td></tr><tr><td align="left">pendiente_pp_anual</td><td align="left" port="pendiente_pp_anual">DOUBLE</td></tr>
      </table>>];
    resultado_ranking [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white">
        <tr><td bgcolor="#3F7F5F" colspan="2"><font color="white"><b>resultado_ranking</b></font></td></tr>
        <tr><td bgcolor="#DDEFE4" colspan="2"><i>year × indicator × state</i></td></tr>
        <tr><td align="left">anio · id_indicador</td><td align="left" port="anio · id_indicador">—</td></tr><tr><td align="left">cve_ent</td><td align="left" port="cve_ent">CHAR(2)</td></tr><tr><td align="left">rango</td><td align="left" port="rango">1-32</td></tr>
      </table>>];
    resultado_validacion_oecd [label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="5" bgcolor="white">
        <tr><td bgcolor="#3F7F5F" colspan="2"><font color="white"><b>resultado_validacion_oecd</b></font></td></tr>
        <tr><td bgcolor="#DDEFE4" colspan="2"><i>year × OECD measure (Mexico)</i></td></tr>
        <tr><td align="left">medida_oecd</td><td align="left" port="medida_oecd">TEXT</td></tr><tr><td align="left">valor_oecd · valor_endutih</td><td align="left" port="valor_oecd · valor_endutih">DOUBLE</td></tr><tr><td align="left">dentro_ic</td><td align="left" port="dentro_ic">BOOLEAN</td></tr>
      </table>>];

    { rank=same; dim_entidad; dim_tiempo; dim_indicador; dim_pais; }
    { rank=same; fact_encuesta_tic; fact_valor_entidad; fact_comercio_electronico; fact_oecd_tic; }
    { rank=same; resultado_brecha; resultado_tendencia; resultado_ranking; resultado_validacion_oecd; }

    dim_entidad:cve_ent -> fact_encuesta_tic:cve_ent;
    dim_tiempo:anio -> fact_encuesta_tic:anio;
    dim_indicador:id_indicador -> fact_encuesta_tic:id_indicador;
    dim_entidad:cve_ent -> fact_valor_entidad:cve_ent;
    dim_tiempo:anio -> fact_valor_entidad:anio;
    dim_tiempo:anio -> fact_comercio_electronico:anio;
    dim_tiempo:anio -> fact_oecd_tic:anio;
    dim_pais:cod_pais -> fact_oecd_tic:cod_pais;

    edge [style=dashed, arrowhead=normal, arrowtail=none, dir=forward, color="#3F7F5F"];
    fact_encuesta_tic -> resultado_brecha;
    fact_encuesta_tic -> resultado_tendencia;
    fact_encuesta_tic -> resultado_ranking;
    fact_encuesta_tic ->
    fact_valor_entidad ->
    fact_encuesta_tic -> resultado_validacion_oecd;
    fact_oecd_tic -> resultado_validacion_oecd;
}
